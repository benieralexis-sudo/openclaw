[Unit]
Description=Run iFIND Doctor every 4 hours
Requires=ifind-doctor.service

[Timer]
# Fire every 4 hours on absolute clock (00, 04, 08, 12, 16, 20 UTC).
# Calibration Alexis 11/05/2026 soir : 2h → 4h pour économiser ~$30/mo.
# 6 runs/jour suffisent pour système stable. Si panne entre 2 runs,
# audit-heal + Auditor (toutes les 8h) servent de filet de sécurité.
OnCalendar=*-*-* 00/4:00:00
AccuracySec=1min
Persistent=true
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
