[Unit]
Description=Run iFIND Auditor every 6 hours
Requires=ifind-auditor.service

[Timer]
# Fréquence 6h (décision Alexis 11/05/2026 — coût plus optimisé vs réactivité)
# 4 runs/jour vs 6/jour → ~$60/mois au lieu de $90/mois.
# Cron pattern : 02h, 08h, 14h, 20h UTC (espacés du cron run-pollers horaire).
OnCalendar=*-*-* 02,08,14,20:00:00
AccuracySec=2min
Persistent=true
RandomizedDelaySec=60s

[Install]
WantedBy=timers.target
