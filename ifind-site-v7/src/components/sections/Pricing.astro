---
import Button from '../ui/Button.astro';

const features = [
  "60 leads qualifiés par mois",
  "<strong>6 Pépites minimum garanties</strong>",
  "Rollover des crédits jusqu'à 4 mois",
  "Setup gratuit + ICP custom inclus",
  "Email opener IA contextualisé par lead",
];
---

<section id="tarifs" class="pricing container container--narrow">
  <header class="pricing-header">
    <span class="pricing-eyebrow">Tarif · § 04</span>
    <h2 class="pricing-h2" data-split>Un seul plan. <em>Pas de fluff.</em></h2>
    <p class="pricing-sub">
      Tarification publique. Pas de Founding Members. Pas de tier confus.
      Une promesse simple, garantie.
    </p>
  </header>

  <article class="plan">
    <div class="plan-head">
      <h3 class="plan-name">iFIND Growth</h3>
      <div class="plan-price">
        <span class="price-value">390</span>
        <span class="price-currency">€</span>
        <span class="price-period">/mois</span>
      </div>
      <p class="plan-billing">Facturation annuelle</p>
    </div>

    <ul class="plan-features">
      {features.map((f) => (
        <li set:html={`<span class="check" aria-hidden="true">✓</span> ${f}`}></li>
      ))}
    </ul>

    <div class="plan-guarantee">
      <span class="guarantee-label">Garantie</span>
      <p>Si moins de 6 Pépites un mois, ton quota est doublé le mois suivant. Sans discussion.</p>
    </div>

    <div class="plan-overage">
      <span class="overage-label">Au-delà du quota</span>
      <p>8 € par lead supplémentaire.</p>
    </div>

    <div class="plan-cta">
      <Button href="/demo" variant="primary" size="lg" arrow>Réserver une démo</Button>
    </div>

    <p class="plan-grandfather">
      Clients existants : tarif initial conservé jusqu'à fin du contrat actuel.
    </p>
  </article>
</section>

<style>
  .pricing {
    padding-block: var(--sp-3xl);
  }

  .pricing-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--sp-2xl);
  }

  .pricing-eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--txt-xs);
    font-weight: 500;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--color-ink-mute);
    margin-bottom: var(--sp-md);
  }

  .pricing-h2 {
    font-family: var(--font-display);
    font-size: var(--txt-2xl);
    font-weight: 400;
    line-height: var(--lh-display);
    letter-spacing: var(--tr-display);
    color: var(--color-ink);
    margin-bottom: var(--sp-base);
  }
  .pricing-h2 em {
    font-style: italic;
    color: var(--color-accent);
  }

  .pricing-sub {
    font-family: var(--font-sans);
    font-size: var(--txt-base);
    line-height: var(--lh-body);
    color: var(--color-ink-mute);
  }

  /* Plan card */
  .plan {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--r-lg);
    padding: var(--sp-2xl);
    max-width: 560px;
    margin: 0 auto;
    box-shadow: var(--sh-md);
  }

  .plan-head {
    text-align: center;
    padding-bottom: var(--sp-lg);
    border-bottom: 1px solid var(--color-line);
    margin-bottom: var(--sp-lg);
  }

  .plan-name {
    font-family: var(--font-display);
    font-size: var(--txt-xl);
    font-weight: 500;
    letter-spacing: var(--tr-tight);
    color: var(--color-ink);
    margin-bottom: var(--sp-base);
  }

  .plan-price {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    font-variant-numeric: tabular-nums;
  }

  .price-value {
    font-family: var(--font-mono);
    font-size: 64px;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: -0.03em;
  }
  .price-currency {
    font-family: var(--font-mono);
    font-size: var(--txt-2xl);
    color: var(--color-ink);
  }
  .price-period {
    font-family: var(--font-sans);
    font-size: var(--txt-base);
    color: var(--color-ink-mute);
    margin-left: 4px;
  }

  .plan-billing {
    font-family: var(--font-sans);
    font-size: var(--txt-sm);
    color: var(--color-ink-mute);
    margin-top: var(--sp-sm);
  }

  .plan-features {
    list-style: none;
    margin: 0 0 var(--sp-lg);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-sm);
    font-family: var(--font-sans);
    font-size: var(--txt-base);
    color: var(--color-ink);
    line-height: var(--lh-body);
  }
  .plan-features .check {
    color: var(--color-accent);
    font-weight: 500;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .plan-guarantee, .plan-overage {
    margin-bottom: var(--sp-base);
    padding: var(--sp-base);
    background: var(--color-bg);
    border-radius: var(--r-md);
    border-left: 3px solid var(--color-accent);
  }

  .plan-guarantee .guarantee-label,
  .plan-overage .overage-label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--txt-xs);
    font-weight: 500;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--sp-xs);
  }

  .plan-guarantee p, .plan-overage p {
    font-family: var(--font-sans);
    font-size: var(--txt-sm);
    color: var(--color-ink);
    line-height: var(--lh-body);
    margin: 0;
  }

  .plan-cta {
    text-align: center;
    margin-top: var(--sp-lg);
  }

  .plan-grandfather {
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--txt-xs);
    color: var(--color-ink-mute);
    margin-top: var(--sp-base);
    font-style: italic;
  }
</style>
