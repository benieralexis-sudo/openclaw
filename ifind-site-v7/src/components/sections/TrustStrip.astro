---
const sources = [
  { name: "INPI",          tag: "Marques · brevets" },
  { name: "Pappers",       tag: "SIRENE · holdings" },
  { name: "France Travail",tag: "Offres d'emploi" },
  { name: "RNE",           tag: "Registre national" },
  { name: "Kaspr",         tag: "Contacts décideurs" },
  { name: "TheirStack",    tag: "Stack tech" },
  { name: "FullEnrich",    tag: "Enrichissement" },
  { name: "Rodz",          tag: "LinkedIn FR" },
  { name: "Apify",         tag: "Sources custom" },
];
---

<section class="trust-strip">
  <div class="container">
    <header class="ts-header">
      <span class="ts-eyebrow">Sources · § 01</span>
      <h2 class="ts-h2">9 sources publiques <em>françaises natives</em>.</h2>
      <p class="ts-sub">
        Aucune intent data agrégée. Aucune navigation web anonyme.
        Que des événements publics datés et attribuables au SIREN.
      </p>
    </header>

    <ul class="sources-grid">
      {sources.map((s) => (
        <li class="source-card">
          <div class="source-dot" aria-hidden="true"></div>
          <div class="source-body">
            <h3 class="source-name">{s.name}</h3>
            <p class="source-tag">{s.tag}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust-strip {
    position: relative;
    padding-block: var(--sp-3xl);
    background:
      radial-gradient(40vw 30vw at 80% 20%, rgba(255, 213, 168, 0.25) 0%, transparent 60%),
      radial-gradient(35vw 25vw at 20% 90%, rgba(255, 229, 199, 0.30) 0%, transparent 60%);
    overflow: hidden;
  }

  .ts-header {
    max-width: 760px;
    margin-bottom: var(--sp-2xl);
  }

  .ts-eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--txt-xs);
    font-weight: 500;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--color-ink-mute);
    margin-bottom: var(--sp-md);
  }

  .ts-h2 {
    font-family: var(--font-display);
    font-size: var(--txt-3xl);
    font-weight: 400;
    line-height: var(--lh-display);
    letter-spacing: var(--tr-display);
    color: var(--color-ink);
    margin-bottom: var(--sp-base);
    text-wrap: balance;
  }
  .ts-h2 em {
    font-style: italic;
    color: var(--color-accent);
  }

  .ts-sub {
    font-family: var(--font-sans);
    font-size: var(--txt-md);
    line-height: var(--lh-body);
    color: var(--color-ink-mute);
    letter-spacing: var(--tr-body);
    max-width: 600px;
  }

  /* Sources grid 3 columns desktop, 1 col mobile */
  .sources-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .source-card {
    background: var(--color-bg-elevated);
    padding: var(--sp-lg);
    display: flex;
    align-items: flex-start;
    gap: var(--sp-md);
    transition: background var(--t-base) var(--ease-smooth);
  }
  .source-card:hover {
    background: var(--color-bg-soft);
  }

  .source-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
    margin-top: 8px;
    box-shadow: 0 0 0 6px rgba(194, 65, 12, 0.08);
  }

  .source-body {
    flex: 1;
    min-width: 0;
  }

  .source-name {
    font-family: var(--font-display);
    font-size: var(--txt-lg);
    font-weight: 500;
    letter-spacing: var(--tr-tight);
    color: var(--color-ink);
    margin: 0 0 var(--sp-xs) 0;
  }

  .source-tag {
    font-family: var(--font-mono);
    font-size: var(--txt-xs);
    color: var(--color-ink-mute);
    letter-spacing: var(--tr-mono);
    margin: 0;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .sources-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .sources-grid { grid-template-columns: 1fr; }
  }
</style>
