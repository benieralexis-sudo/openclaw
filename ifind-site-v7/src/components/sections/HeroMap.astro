    </g>

    <!-- Lignes de connexion data-flow -->
    <g class="connections">
      {liens.map(([a, b]) => (
        <line data-draw
          x1={m[a].x} y1={m[a].y}
          x2={m[b].x} y2={m[b].y}
          stroke="rgba(194, 65, 12, 0.25)" stroke-width="1" stroke-dasharray="4 4" />
      ))}
    </g>

    <!-- Dots villes qui pulsent -->
    <g class="cities">
      {villes.map((v, i) => (
        <g class="city-dot" style={`--city-delay: ${v.delay}s; --city-i: ${i};`} data-draw-fade>
          <!-- Glow halo -->
          <circle cx={v.x} cy={v.y} r="22" fill="url(#cityGlow)" class="halo"/>
          <!-- Ring pulse -->
          <circle cx={v.x} cy={v.y} r="6" fill="none" stroke="rgba(194, 65, 12, 0.6)" stroke-width="1" class="ring"/>
          <!-- Center dot -->
          <circle cx={v.x} cy={v.y} r="4" fill="#C2410C" class="dot"/>
          <!-- City label (mono small) -->
          <text x={v.x + 14} y={v.y + 4}
            font-family="JetBrains Mono, monospace" font-size="11" fill="#1A1A2E"
            class="label">{v.name}</text>
        </g>
      ))}
    </g>

  </svg>

  <!-- Live indicator overlay -->
  <div class="map-live">
    <span class="live-dot" aria-hidden="true"></span>
    <span class="live-text">Live · 9 sources · FR</span>
  </div>
</div>

<style>
  .hero-map {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.65;
  }

  .hero-map svg {
    width: 90%;
    max-width: 760px;
    height: auto;
    max-height: 90%;
  }

  /* France path stroke draw-on-mount */
  .france-shape path {
    stroke-dasharray: 12000;
    stroke-dashoffset: 12000;
    animation: drawFrance 3.5s var(--ease-snap) 0.3s forwards;
  }

  @keyframes drawFrance {
    to { stroke-dashoffset: 0; }
  }

  /* Connections lines */
  .connections line {
    stroke-dasharray: 4 4;
    animation: dashFlow 6s linear infinite;
    opacity: 0;
    animation-delay: 2s;
    animation-fill-mode: forwards;
  }
  .connections line:nth-child(2n) { animation-delay: 2.3s; }
  .connections line:nth-child(3n) { animation-delay: 2.6s; }

  @keyframes dashFlow {
    0% { stroke-dashoffset: 0; opacity: 0; }
    10% { opacity: 1; }
    100% { stroke-dashoffset: -100; opacity: 1; }
  }

  /* City dots pulse staggered */
  .city-dot { opacity: 0; animation: cityAppear 0.6s var(--ease-snap) forwards; animation-delay: calc(2s + var(--city-delay)); }

  @keyframes cityAppear {
    to { opacity: 1; }
  }

  .city-dot .ring {
    transform-origin: center;
    transform-box: fill-box;
    animation: cityPulse 3s var(--ease-smooth) infinite;
    animation-delay: var(--city-delay);
  }

  @keyframes cityPulse {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(2.5); opacity: 0; }
  }

  .city-dot .dot {
    animation: cityDot 3s ease-in-out infinite;
    animation-delay: var(--city-delay);
  }

  @keyframes cityDot {
    0%, 100% { r: 4; }
    50% { r: 5; }
  }

  .city-dot .label {
    opacity: 0;
    animation: labelFade 0.8s var(--ease-snap) forwards;
    animation-delay: calc(2.4s + var(--city-delay));
  }

  @keyframes labelFade {
    to { opacity: 0.75; }
  }

  /* Live indicator badge */
  .map-live {
    position: absolute;
    bottom: var(--sp-md);
    right: var(--sp-md);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-xs);
    background: rgba(250, 250, 247, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-line);
    padding: 6px 12px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--txt-xs);
    color: var(--color-ink-mute);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    opacity: 0;
    animation: liveBadgeFade 0.6s var(--ease-snap) 4s forwards;
  }

  @keyframes liveBadgeFade {
    to { opacity: 1; }
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-signal-hot);
    animation: pulse 1.5s var(--ease-smooth) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .france-shape path,
    .connections line,
    .city-dot,
    .city-dot .ring,
    .city-dot .dot,
    .city-dot .label,
    .map-live,
    .live-dot {
      animation: none !important;
      opacity: 1 !important;
      stroke-dashoffset: 0 !important;
    }
  }

  @media (max-width: 900px) {
    .hero-map { opacity: 0.35; }
    .hero-map svg { max-width: 100%; }
  }
</style>
