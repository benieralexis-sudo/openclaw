---
/**
 * HeroMap — Carte FR signature avec dots villes qui pulsent
 * Signature iFIND : la donnée publique française géolocalisée.
 *
 * Approche : SVG path France + 9 dots ville + lignes connexion.
 * Pas de Three.js (perf préservée, mobile OK natif).
 */

// 9 villes principales FR avec coordonnées dans le viewBox SVG France
const villes = [
  { name: 'Paris',      x: 530, y: 235, delay: 0   },
  { name: 'Lyon',       x: 610, y: 480, delay: 0.4 },
  { name: 'Marseille',  x: 650, y: 700, delay: 0.8 },
  { name: 'Bordeaux',   x: 370, y: 580, delay: 1.2 },
  { name: 'Lille',      x: 540, y: 100, delay: 1.6 },
  { name: 'Toulouse',   x: 460, y: 700, delay: 2.0 },
  { name: 'Nantes',     x: 290, y: 425, delay: 2.4 },
  { name: 'Strasbourg', x: 770, y: 230, delay: 2.8 },
  { name: 'Rennes',     x: 290, y: 320, delay: 3.2 },
];

// Connexions principales (réseau "data flow")
const liens = [
  ['Paris', 'Lyon'],
  ['Paris', 'Lille'],
  ['Paris', 'Strasbourg'],
  ['Paris', 'Nantes'],
  ['Lyon', 'Marseille'],
  ['Lyon', 'Bordeaux'],
  ['Bordeaux', 'Toulouse'],
  ['Nantes', 'Rennes'],
];

// Map name → coords for line lookup
const m = Object.fromEntries(villes.map((v) => [v.name, v]));
---

<div class="hero-map" aria-hidden="true" data-draw-svg>
  <svg viewBox="0 0 1100 1000" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">

    <defs>
      <radialGradient id="cityGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="rgba(194, 65, 12, 0.5)"/>
        <stop offset="100%" stop-color="rgba(194, 65, 12, 0)"/>
      </radialGradient>
      <filter id="softShadow">
        <feGaussianBlur stdDeviation="1"/>
      </filter>
    </defs>

    <!-- Hexagone France stroke éditorial -->
    <g class="france-shape">
      <path data-draw stroke="#1A1A2E" stroke-width="1" fill="rgba(26, 26, 46, 0.025)" stroke-linejoin="round"
