---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
---

<section class="hero-wrap">
<div class="hero-mesh" aria-hidden="true"></div>
<section class="hero container">
  <div class="hero-text">
    <Eyebrow label="Trigger Engine · Live FR" accent withDot />

    <h1 class="hero-h1" data-split>
      La prospection ne se devine pas. <em>Elle se prouve.</em>
    </h1>

    <p class="hero-sub">
      9 sources publiques françaises natives détectent en temps réel les signaux
      d'achat datés des PME et ETI. Levées, hires Sales, dépôts INPI, ouvertures
      de filiale — chaque événement est vérifiable, attribuable, livré sous 24h.
    </p>

    <div class="hero-ctas">
      <Button href="/demo" variant="primary" size="md" arrow>Réserver une démo</Button>
      <Button href="#methode" variant="underline">Voir la méthode</Button>
    </div>
  </div>

  <aside class="data-panel" aria-label="Signaux détectés récemment">
    <header class="data-panel-header">
      <span class="data-panel-title">Signaux · 24h</span>
      <span class="data-panel-status">
        <span class="status-dot" aria-hidden="true"></span>
        Live
      </span>
    </header>

    <ol class="trigger-list">
      <li class="trigger trigger--hot">
        <span class="trigger-icon" aria-hidden="true">€</span>
        <div class="trigger-body">
          <div class="trigger-company">Société #421</div>
          <div class="trigger-detail">Levée Series B · 18M€ · 2h</div>
        </div>
        <span class="trigger-score">9.2</span>
      </li>
      <li class="trigger trigger--hot">
        <span class="trigger-icon" aria-hidden="true">+</span>
        <div class="trigger-body">
          <div class="trigger-company">Société #128</div>
          <div class="trigger-detail">Hire Head of Sales · 4h</div>
        </div>
        <span class="trigger-score">8.7</span>
      </li>
      <li class="trigger trigger--warm">
        <span class="trigger-icon" aria-hidden="true">§</span>
        <div class="trigger-body">
          <div class="trigger-company">Société #305</div>
          <div class="trigger-detail">Dépôt INPI Class 9 · 7h</div>
        </div>
        <span class="trigger-score">7.4</span>
      </li>
      <li class="trigger trigger--warm">
        <span class="trigger-icon" aria-hidden="true">▲</span>
        <div class="trigger-body">
          <div class="trigger-company">Société #587</div>
          <div class="trigger-detail">Ouverture filiale · 11h</div>
        </div>
        <span class="trigger-score">7.1</span>
      </li>
    </ol>
  </aside>
</section>
</section>

<style>
  /* Wrapper + gradient mesh background animé (Classroom 03 boss battle hero shader) */
  .hero-wrap {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .hero-mesh {
    position: absolute;
    inset: -10% -10% 0 -10%;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(45vw 45vw at 18% 28%, rgba(232, 159, 44, 0.18) 0%, transparent 55%),
      radial-gradient(50vw 40vw at 82% 72%, rgba(255, 237, 213, 0.55) 0%, transparent 60%),
      radial-gradient(35vw 35vw at 62% 18%, rgba(194, 65, 12, 0.10) 0%, transparent 50%),
      radial-gradient(40vw 30vw at 10% 90%, rgba(232, 159, 44, 0.08) 0%, transparent 55%);
    filter: blur(60px);
    animation: meshDrift 24s ease-in-out infinite alternate;
    will-change: transform;
  }

  @keyframes meshDrift {
    0%   { transform: translate3d(0%, 0%, 0) scale(1); }
    33%  { transform: translate3d(2%, -2%, 0) scale(1.05); }
    66%  { transform: translate3d(-3%, 3%, 0) scale(0.97); }
    100% { transform: translate3d(1%, -1%, 0) scale(1.02); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mesh { animation: none; }
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--sp-3xl);
    align-items: center;
    padding-block: var(--sp-3xl) var(--sp-2xl);
    position: relative;
    z-index: 1;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-size: var(--txt-4xl);
    font-weight: 400;
    letter-spacing: var(--tr-display);
    line-height: var(--lh-display);
    margin-block: var(--sp-base) var(--sp-base);
    text-wrap: balance;
  }

  .hero-sub {
    font-family: var(--font-sans);
    font-size: var(--txt-md);
    line-height: var(--lh-body);
    color: var(--color-ink-mute);
    max-width: 56ch;
    margin-bottom: var(--sp-xl);
    letter-spacing: var(--tr-body);
  }

  .hero-ctas {
    display: flex;
    gap: var(--sp-base);
    align-items: center;
    flex-wrap: wrap;
  }

  /* Data panel — Clay-school overlay */
  .data-panel {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line-strong);
    padding: var(--sp-lg);
    box-shadow: var(--sh-lg);
  }

  .data-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--sp-md);
    margin-bottom: var(--sp-base);
    border-bottom: 1px solid var(--color-line);
  }

  .data-panel-title {
    font-family: var(--font-mono);
    font-size: var(--txt-xs);
    color: var(--color-ink-mute);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
  }

  .data-panel-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--txt-xs);
    color: var(--color-signal-hot);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-signal-hot);
    animation: pulse 1.5s var(--ease-smooth) infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.4); }
  }

  .trigger-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
  }

  .trigger {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--sp-md);
    align-items: center;
    padding: var(--sp-md) var(--sp-sm);
    border-bottom: 1px solid var(--color-line);
    transition: background var(--t-base) var(--ease-smooth),
                padding-left var(--t-base) var(--ease-smooth);
  }
  .trigger:last-child { border-bottom: none; }
  .trigger:hover {
    background: var(--color-bg);
    padding-left: var(--sp-base);
  }

  .trigger-icon {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    border-radius: 2px;
  }
  .trigger--hot .trigger-icon { background: var(--color-accent); color: white; }
  .trigger--warm .trigger-icon { background: var(--color-accent-soft); color: var(--color-accent); }

  .trigger-body { min-width: 0; }
  .trigger-company {
    font-family: var(--font-display);
    font-size: var(--txt-base);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 2px;
  }
  .trigger-detail {
    font-family: var(--font-mono);
    font-size: var(--txt-xs);
    color: var(--color-ink-mute);
    letter-spacing: var(--tr-mono);
  }

  .trigger-score {
    font-family: var(--font-mono);
    font-size: var(--txt-sm);
    font-weight: 500;
    letter-spacing: var(--tr-mono);
    font-variant-numeric: tabular-nums;
  }
  .trigger--hot .trigger-score { color: var(--color-signal-hot); }
  .trigger--warm .trigger-score { color: var(--color-signal-warm); }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--sp-xl);
      padding-block: var(--sp-xl) var(--sp-lg);
    }
  }
</style>
