---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
---

<section class="hero-wrap">
<div class="hero-mesh" aria-hidden="true"></div>
<canvas id="hero-network" class="hero-network" aria-hidden="true"></canvas>
<section class="hero container">
  <div class="hero-text">
    <Eyebrow label="Trigger Engine · Live FR" accent withDot />

    <h1 class="hero-h1" data-split>
      La prospection ne se devine pas. <em>Elle se prouve.</em>
    </h1>

    <p class="hero-sub">
      9 sources publiques françaises natives détectent en temps réel les signaux
      d'achat datés des PME et ETI. Levées, hires Sales, dépôts INPI, ouvertures
      de filiale — chaque événement est vérifiable, attribuable, livré sous 24h.
    </p>

    <div class="hero-ctas">
      <Button href="/demo" variant="primary" size="md" arrow>Réserver une démo</Button>
      <Button href="#methode" variant="underline">Voir la méthode</Button>
    </div>
  </div>

  <aside class="data-panel" aria-label="Signaux détectés récemment">
    <header class="data-panel-header">
      <span class="data-panel-title">Signaux · 24h</span>
      <span class="data-panel-status">
        <span class="status-dot" aria-hidden="true"></span>
        Live
      </span>
    </header>

    <ol class="trigger-list">
      <li class="trigger trigger--hot">
        <span class="trigger-icon" aria-hidden="true">€</span>
        <div class="trigger-body">
          <div class="trigger-company">Société #421</div>
          <div class="trigger-detail">Levée Series B · 18M€ · 2h</div>
        </div>
        <span class="trigger-score">9.2</span>
      </li>
      <li class="trigger trigger--hot">
        <span class="trigger-icon" aria-hidden="true">+</span>
        <div class="trigger-body">
          <div class="trigger-company">Société #128</div>
          <div class="trigger-detail">Hire Head of Sales · 4h</div>
        </div>
        <span class="trigger-score">8.7</span>
      </li>
      <li class="trigger trigger--warm">
        <span class="trigger-icon" aria-hidden="true">§</span>
        <div class="trigger-body">
          <div class="trigger-company">Société #305</div>
          <div class="trigger-detail">Dépôt INPI Class 9 · 7h</div>
        </div>
        <span class="trigger-score">7.4</span>
      </li>
      <li class="trigger trigger--warm">
        <span class="trigger-icon" aria-hidden="true">▲</span>
        <div class="trigger-body">
          <div class="trigger-company">Société #587</div>
          <div class="trigger-detail">Ouverture filiale · 11h</div>
        </div>
        <span class="trigger-score">7.1</span>
      </li>
    </ol>
  </aside>
</section>
</section>

<script>
  // Hero Canvas Network — effet "data flow ambient" video-like
  // Particles qui flottent + lignes entre voisins + quelques particles HOT pulsent
  const canvas = document.getElementById('hero-network') as HTMLCanvasElement | null;
  if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let W = 0, H = 0, DPR = Math.min(window.devicePixelRatio || 1, 2);

      const COUNT = 70;          // nombre de particles
      const MAX_DIST = 140;      // distance max pour lien
      const HOT_RATIO = 0.12;    // % particles "hot" qui pulsent en orange

      interface P { x: number; y: number; vx: number; vy: number; hot: boolean; phase: number; }
      const particles: P[] = [];

      function resize() {
        const rect = canvas!.getBoundingClientRect();
        W = rect.width;
        H = rect.height;
        canvas!.width = W * DPR;
        canvas!.height = H * DPR;
        ctx!.scale(DPR, DPR);
      }

      function init() {
        particles.length = 0;
        for (let i = 0; i < COUNT; i++) {
          particles.push({
            x: Math.random() * W,
            y: Math.random() * H,
            vx: (Math.random() - 0.5) * 0.25,
            vy: (Math.random() - 0.5) * 0.25,
            hot: Math.random() < HOT_RATIO,
            phase: Math.random() * Math.PI * 2,
          });
        }
      }

      function step(t: number) {
        ctx!.clearRect(0, 0, W, H);

        // Update + draw particles
        for (const p of particles) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > W) p.vx *= -1;
          if (p.y < 0 || p.y > H) p.vy *= -1;
          p.x = Math.max(0, Math.min(W, p.x));
          p.y = Math.max(0, Math.min(H, p.y));
        }

        // Draw connections (lines between near particles)
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const a = particles[i], b = particles[j];
            const dx = a.x - b.x, dy = a.y - b.y;
            const d = Math.hypot(dx, dy);
            if (d < MAX_DIST) {
              const alpha = (1 - d / MAX_DIST) * 0.18;
              ctx!.strokeStyle = `rgba(26, 26, 46, ${alpha})`;
              ctx!.lineWidth = 1;
              ctx!.beginPath();
              ctx!.moveTo(a.x, a.y);
              ctx!.lineTo(b.x, b.y);
              ctx!.stroke();
            }
          }
        }

        // Draw particles (dots)
        for (const p of particles) {
          if (p.hot) {
            // Hot pulse — orange accent
            const pulse = 0.5 + 0.5 * Math.sin(t * 0.002 + p.phase);
            ctx!.fillStyle = `rgba(194, 65, 12, ${0.4 + pulse * 0.4})`;
            ctx!.beginPath();
            ctx!.arc(p.x, p.y, 3 + pulse * 1.5, 0, Math.PI * 2);
            ctx!.fill();

            // Halo
            const grad = ctx!.createRadialGradient(p.x, p.y, 0, p.x, p.y, 14 + pulse * 6);
            grad.addColorStop(0, `rgba(194, 65, 12, ${0.12 + pulse * 0.1})`);
            grad.addColorStop(1, 'rgba(194, 65, 12, 0)');
            ctx!.fillStyle = grad;
            ctx!.beginPath();
            ctx!.arc(p.x, p.y, 14 + pulse * 6, 0, Math.PI * 2);
            ctx!.fill();
          } else {
            ctx!.fillStyle = 'rgba(26, 26, 46, 0.45)';
            ctx!.beginPath();
            ctx!.arc(p.x, p.y, 1.5, 0, Math.PI * 2);
            ctx!.fill();
          }
        }

        requestAnimationFrame(step);
      }

      resize();
      init();
      requestAnimationFrame(step);
      window.addEventListener('resize', () => { resize(); init(); }, { passive: true });
    }
  }
</script>

<style>
  /* Wrapper + gradient mesh + canvas network (Classroom 03 boss battle hero) */
  .hero-wrap {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 90vh;
  }

  .hero-network {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    opacity: 0.35;
  }

  /* Mercury-style massive gradient mesh — VISIBLE, warm, ample */
  .hero-mesh {
    position: absolute;
    inset: -20% -20% -20% -20%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(60vw 60vw at 15% 25%, #FFE5C7 0%, transparent 50%),
      radial-gradient(70vw 55vw at 85% 75%, #FFD9A8 0%, transparent 55%),
      radial-gradient(50vw 50vw at 60% 15%, #FFEDD5 0%, transparent 55%),
      radial-gradient(55vw 45vw at 30% 95%, #FFC692 0%, transparent 50%),
      radial-gradient(45vw 45vw at 95% 30%, #FFEFE0 0%, transparent 55%);
    filter: blur(80px);
    animation: meshDrift 22s ease-in-out infinite alternate;
    will-change: transform;
  }

  @keyframes meshDrift {
    0%   { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
    25%  { transform: translate3d(3%, -4%, 0) scale(1.08) rotate(1deg); }
    50%  { transform: translate3d(-2%, 5%, 0) scale(0.95) rotate(-1deg); }
    75%  { transform: translate3d(-4%, -2%, 0) scale(1.05) rotate(0.5deg); }
    100% { transform: translate3d(2%, 3%, 0) scale(1.02) rotate(-0.5deg); }
  }

  /* Second layer — accent orange burnt qui pulse plus rapidement (Mercury layered effect) */
  .hero-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(30vw 30vw at 70% 40%, rgba(194, 65, 12, 0.12) 0%, transparent 60%),
      radial-gradient(25vw 25vw at 25% 70%, rgba(194, 65, 12, 0.08) 0%, transparent 65%);
    filter: blur(40px);
    mix-blend-mode: multiply;
    animation: accentPulse 14s ease-in-out infinite alternate;
  }

  @keyframes accentPulse {
    0%   { transform: translate(0, 0) scale(1); opacity: 0.8; }
    50%  { transform: translate(-3%, 4%) scale(1.15); opacity: 1; }
    100% { transform: translate(4%, -3%) scale(0.92); opacity: 0.7; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mesh,
    .hero-wrap::after { animation: none; }
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--sp-3xl);
    align-items: center;
    padding-block: var(--sp-3xl) var(--sp-2xl);
    position: relative;
    z-index: 1;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-size: var(--txt-4xl);
    font-weight: 400;
    letter-spacing: var(--tr-display);
    line-height: var(--lh-display);
    margin-block: var(--sp-base) var(--sp-base);
    text-wrap: balance;
  }

  .hero-sub {
    font-family: var(--font-sans);
    font-size: var(--txt-md);
    line-height: var(--lh-body);
    color: var(--color-ink-mute);
    max-width: 56ch;
    margin-bottom: var(--sp-xl);
    letter-spacing: var(--tr-body);
  }

  .hero-ctas {
    display: flex;
    gap: var(--sp-base);
    align-items: center;
    flex-wrap: wrap;
  }

  /* Data panel — Clay-school overlay */
  .data-panel {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line-strong);
    padding: var(--sp-lg);
    box-shadow: var(--sh-lg);
  }

  .data-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--sp-md);
    margin-bottom: var(--sp-base);
    border-bottom: 1px solid var(--color-line);
  }

  .data-panel-title {
    font-family: var(--font-mono);
    font-size: var(--txt-xs);
    color: var(--color-ink-mute);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
  }

  .data-panel-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--txt-xs);
    color: var(--color-signal-hot);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-signal-hot);
    animation: pulse 1.5s var(--ease-smooth) infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.4); }
  }

  .trigger-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
  }

  .trigger {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--sp-md);
    align-items: center;
    padding: var(--sp-md) var(--sp-sm);
    border-bottom: 1px solid var(--color-line);
    transition: background var(--t-base) var(--ease-smooth),
                padding-left var(--t-base) var(--ease-smooth);
  }
  .trigger:last-child { border-bottom: none; }
  .trigger:hover {
    background: var(--color-bg);
    padding-left: var(--sp-base);
  }

  .trigger-icon {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    border-radius: 2px;
  }
  .trigger--hot .trigger-icon { background: var(--color-accent); color: white; }
  .trigger--warm .trigger-icon { background: var(--color-accent-soft); color: var(--color-accent); }

  .trigger-body { min-width: 0; }
  .trigger-company {
    font-family: var(--font-display);
    font-size: var(--txt-base);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 2px;
  }
  .trigger-detail {
    font-family: var(--font-mono);
    font-size: var(--txt-xs);
    color: var(--color-ink-mute);
    letter-spacing: var(--tr-mono);
  }

  .trigger-score {
    font-family: var(--font-mono);
    font-size: var(--txt-sm);
    font-weight: 500;
    letter-spacing: var(--tr-mono);
    font-variant-numeric: tabular-nums;
  }
  .trigger--hot .trigger-score { color: var(--color-signal-hot); }
  .trigger--warm .trigger-score { color: var(--color-signal-warm); }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--sp-xl);
      padding-block: var(--sp-xl) var(--sp-lg);
    }
  }
</style>
