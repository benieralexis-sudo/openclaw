---
import Button from '../ui/Button.astro';
---

<section class="final-cta container container--narrow">
  <span class="cta-eyebrow">Démo · 30 min</span>
  <h2 class="cta-h2" data-split>
    Trois Pépites alignées à votre ICP. <em>En direct.</em>
  </h2>
  <p class="cta-sub">
    30 minutes. Pas de slides. Pas de pitch.
    On vous montre 3 Pépites détectées la semaine dernière sur des sociétés
    qui ressemblent à vos meilleurs clients.
  </p>
  <div class="cta-action">
    <Button href="/demo" variant="primary" size="lg" arrow magnetic>Réserver une démo</Button>
  </div>
  <p class="cta-footnote">
    Démo livrée par Alexis Bénier · CEO iFIND · benieralexis@gmail.com
  </p>
</section>

<style>
  .final-cta {
    position: relative;
    padding-block: var(--sp-4xl) var(--sp-3xl);
    text-align: center;
    isolation: isolate;
  }

  .final-cta::before {
    content: '';
    position: absolute;
    inset: -20%;
    z-index: -1;
    background:
      radial-gradient(50vw 40vw at 50% 30%, #FFE5C7 0%, transparent 55%),
      radial-gradient(40vw 35vw at 20% 80%, #FFD9A8 0%, transparent 55%),
      radial-gradient(45vw 40vw at 80% 70%, #FFEDD5 0%, transparent 55%),
      radial-gradient(30vw 25vw at 60% 50%, rgba(194, 65, 12, 0.12) 0%, transparent 60%);
    filter: blur(70px);
    animation: ctaMeshDrift 20s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes ctaMeshDrift {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(2%, -3%) scale(1.05); }
    100% { transform: translate(-3%, 2%) scale(0.98); }
  }

  @media (prefers-reduced-motion: reduce) {
    .final-cta::before { animation: none; }
  }

  .cta-eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--txt-xs);
    font-weight: 500;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--sp-base);
  }

  .cta-h2 {
    font-family: var(--font-display);
    font-size: clamp(48px, 6.5vw, 88px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: var(--tr-display);
    color: var(--color-ink);
    margin-bottom: var(--sp-lg);
    max-width: 880px;
    margin-inline: auto;
    text-wrap: balance;
  }
  .cta-h2 em {
    font-style: italic;
    color: var(--color-accent);
  }

  .cta-sub {
    font-family: var(--font-sans);
    font-size: var(--txt-md);
    line-height: var(--lh-body);
    color: var(--color-ink-mute);
    max-width: 560px;
    margin: 0 auto var(--sp-xl);
  }

  .cta-action {
    margin-bottom: var(--sp-lg);
  }

  .cta-footnote {
    font-family: var(--font-mono);
    font-size: var(--txt-xs);
    color: var(--color-ink-mute);
    letter-spacing: var(--tr-mono);
    margin: 0;
  }
</style>
