---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'amber';
  size?: 'sm' | 'md' | 'lg';
  magnetic?: boolean;
  arrow?: boolean;
}
const {
  href,
  variant = 'primary',
  size = 'md',
  magnetic = false,
  arrow = false,
} = Astro.props;

const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${size}`,
  magnetic ? 'btn--magnetic' : '',
].filter(Boolean).join(' ');
---

{href ? (
  <a class={classes} href={href} data-cursor="hover">
    <span class="btn-label"><slot /></span>
    {arrow && <span class="btn-arrow" aria-hidden="true">→</span>}
    {magnetic && <span class="btn-halo" aria-hidden="true"></span>}
  </a>
) : (
  <button type="button" class={classes} data-cursor="hover">
    <span class="btn-label"><slot /></span>
    {arrow && <span class="btn-arrow" aria-hidden="true">→</span>}
    {magnetic && <span class="btn-halo" aria-hidden="true"></span>}
  </button>
)}

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-sm);
    font-family: var(--font-sans);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.005em;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: transform var(--t-base) var(--ease-spring),
                background var(--t-base) var(--ease-quint),
                color var(--t-base) var(--ease-quint),
                border-color var(--t-base) var(--ease-quint);
    will-change: transform;
    white-space: nowrap;
    text-decoration: none;
    border: 1px solid transparent;
    isolation: isolate;
  }

  .btn--sm  { font-size: 13px; padding: 9px 14px; }
  .btn--md  { font-size: 15px; padding: 14px 22px; }
  .btn--lg  { font-size: 17px; padding: 18px 32px; }

  .btn--primary {
    background: var(--color-ink);
    color: var(--color-cream);
  }
  .btn--primary:hover {
    background: var(--color-ink-soft);
    transform: translateY(-1px);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-line);
  }
  .btn--ghost:hover {
    border-color: var(--color-ink);
    background: var(--color-cream-warm);
  }

  .btn--amber {
    background: var(--color-amber);
    color: var(--color-ink);
  }
  .btn--amber:hover {
    background: var(--color-amber-deep);
  }

  .btn-arrow {
    display: inline-block;
    transition: transform var(--t-base) var(--ease-quint);
  }
  .btn:hover .btn-arrow { transform: translateX(4px); }

  .btn--magnetic { position: relative; }
  .btn-halo {
    position: absolute;
    inset: -12px;
    border-radius: inherit;
    background: radial-gradient(closest-side, rgba(232,159,44,0.35), transparent 70%);
    opacity: 0;
    transition: opacity var(--t-base) var(--ease-quint);
    pointer-events: none;
    z-index: -1;
    filter: blur(8px);
  }
  .btn--magnetic:hover .btn-halo { opacity: 1; }
</style>
