---
interface Props {
  label: string;
  amber?: boolean;
  withDot?: boolean;
  dotColor?: 'signal' | 'amber' | 'pulse';
}
const { label, amber = false, withDot = false, dotColor = 'signal' } = Astro.props;
---

<span class={`eyebrow-component ${amber ? 'is-amber' : ''}`}>
  {withDot && <span class={`eb-dot eb-dot--${dotColor}`} aria-hidden="true"></span>}
  <span class="eb-label">{label}</span>
</span>

<style>
  .eyebrow-component {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-sm);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--color-slate-warm);
    line-height: 1;
  }
  .eyebrow-component.is-amber { color: var(--color-amber); }

  .eb-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 0 0 currentColor;
    animation: ebPulse 2.4s var(--ease-quint) infinite;
  }
  .eb-dot--signal { background: var(--color-signal-ok); }
  .eb-dot--amber  { background: var(--color-amber); }
  .eb-dot--pulse  { background: var(--color-alert-pulse); }

  @keyframes ebPulse {
    0%, 80%, 100% { box-shadow: 0 0 0 0 transparent; transform: scale(1); }
    8%, 30% { box-shadow: 0 0 0 6px transparent; transform: scale(1.3); }
  }

  @media (prefers-reduced-motion: reduce) {
    .eb-dot { animation: none; }
  }
</style>
