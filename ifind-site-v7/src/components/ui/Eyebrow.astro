---
interface Props {
  label: string;
  accent?: boolean;
  withDot?: boolean;
  dotColor?: 'accent' | 'hot' | 'ok';
}
const {
  label,
  accent = false,
  withDot = false,
  dotColor = 'accent',
} = Astro.props;
---

<span class={`eyebrow ${accent ? 'eyebrow--accent' : ''}`}>
  {withDot && <span class={`eb-dot eb-dot--${dotColor}`} aria-hidden="true"></span>}
  <span class="eb-label">{label}</span>
</span>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-sm);
    font-family: var(--font-sans);
    font-size: var(--txt-xs);
    font-weight: 500;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--color-ink-mute);
    line-height: 1;
  }
  .eyebrow--accent { color: var(--color-accent); }

  .eb-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 0 0 currentColor;
    animation: ebPulse 2.4s var(--ease-smooth) infinite;
  }
  .eb-dot--accent { background: var(--color-accent); }
  .eb-dot--hot    { background: var(--color-signal-hot); }
  .eb-dot--ok     { background: var(--color-signal-ok); }

  @keyframes ebPulse {
    0%, 80%, 100% {
      box-shadow: 0 0 0 0 transparent;
      transform: scale(1);
    }
    8%, 30% {
      box-shadow: 0 0 0 6px transparent;
      transform: scale(1.3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eb-dot { animation: none; }
  }
</style>
