---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'iFIND — Vos futurs clients vous cherchent déjà.',
  description = "Le sismographe iFIND capte en temps réel les signaux d'achat des PME tech FR — levées, recrutements C-level, dépôts INPI, M&A. 9 sources souveraines, 0 intent data américain.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />

  <!-- Favicon SVG signature sismographe -->
  <link
    rel="icon"
    type="image/svg+xml"
    href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23F5F1EA'/><path d='M3 16 L8 16 L9 14 L11 18 L12 16 L14 16 L15 8 L17 24 L18 16 L21 16 L22 14 L23 18 L24 16 L29 16' stroke='%230F0D0A' stroke-width='1.6' fill='none' stroke-linecap='round' stroke-linejoin='round'/><circle cx='17' cy='16' r='2.4' fill='%23E89F2C'/></svg>"
  />
  <meta name="theme-color" content="#0F0D0A" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://ifind.fr" />
  <meta property="og:locale" content="fr_FR" />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- View Transitions API cross-document -->
  <meta name="view-transition" content="same-origin" />

  <!-- Fonts : Geist + Space Grotesk + Geist Mono — Variable axis -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&family=Space+Grotesk:wght@300..700&display=swap"
    rel="stylesheet"
  />
</head>

<body>
  <a href="#main" class="skip-link">Aller au contenu</a>

  <main id="main">
    <slot />
  </main>
</body>
</html>
