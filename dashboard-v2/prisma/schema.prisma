// iFIND — Schema Prisma multi-tenant
// Phase 1.3 du plan refonte dashboard
//
// Convention :
// - Tous les modèles "scopés" client ont un `clientId` indexé.
// - User est scopé via clientId (clients) ou scopeClientIds (commerciaux).
// - Soft-delete via `deletedAt` plutôt que DELETE physique.
// - timestamps en UTC, formatés français côté UI.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================================
// AUTH (Better Auth)
// =====================================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  image          String?
  emailVerified  Boolean   @default(false)
  passwordHash   String?
  role           UserRole  @default(CLIENT)
  // Multi-tenant scope
  clientId       String? // Pour rôle CLIENT/EDITOR/VIEWER : leur unique client
  scopeClientIds String[]  @default([]) // Pour rôle COMMERCIAL : liste de clients gérés
  client         Client?   @relation("ClientOwner", fields: [clientId], references: [id], onDelete: SetNull)
  // Préférences
  locale         String    @default("fr-FR")
  timezone       String    @default("Europe/Paris")
  preferences    Json?
  // Flags
  onboardingDone Boolean   @default(false)
  // Audit
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  sessions   Session[]
  accounts   Account[]
  // Sprint 6 (10/05/2026) — notifications retire (table Notification droppee)
  activities LeadActivity[]

  @@index([clientId])
  @@index([role])
  @@index([deletedAt])
}

enum UserRole {
  ADMIN // Voit tout, peut tout faire
  COMMERCIAL // Voit ses scopeClientIds (commerciaux amis)
  CLIENT // Voit son seul client
  EDITOR // Comme CLIENT mais peut éditer
  VIEWER // Comme CLIENT mais lecture seule
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  idToken               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// =====================================================================
// CLIENT (tenant)
// =====================================================================

model Client {
  id                       String       @id @default(cuid())
  slug                     String       @unique // "digitestlab", "ifind"
  name                     String
  legalName                String?
  industry                 String?
  region                   String?
  size                     String? // "TPE", "PME", "ETI", "GE"
  status                   ClientStatus @default(PROSPECT)
  plan                     ClientPlan   @default(LEADS_DATA)
  // Branding (optionnel)
  primaryColor             String?
  logoUrl                  String?
  // Contact
  contactEmail             String?
  contactPhone             String?
  // Cal.com booking link slug (ex "alex/digitestlab-15min")
  // Injecté dans body pitch Opus pour permettre booking 1-clic.
  calcomSlug               String?
  // ICP config (JSON flexible)
  icp                      Json?
  // Sprint 3 (10/05/2026) — Configuration delivery par client (digest hebdo,
  // alertes realtime, branding email). Voir lib/delivery-config.ts pour Zod.
  deliveryConfig           Json?
  // Sprint 7 (10/05/2026) — Quotas API par client (Anthropic, Apify, TheirStack).
  // Permet d'isoler la facture par tenant + alerter quand 80%/100% atteint.
  // Voir lib/quota-config.ts pour Zod schema + quota-checker.ts pour usage.
  quotaConfig              Json?
  // Sprint Saint Graal (10/05/2026) — Systeme credits + garantie Pepite.
  // Plan Growth public = 390eur/mo, 60 credits inclus, 6 Pepites garanties.
  // Voir lib/credits.ts pour la mecanique.
  creditsBalance           Int          @default(0) // solde credits leads qualif courant (incluant rollover non-expires)
  creditsMonthlyQuota      Int          @default(60) // quota inclus chaque mois (Growth=60)
  pepitesThisMonth         Int          @default(0) // compteur Pepites livrees mois courant
  pepitesGuaranteed        Int          @default(6) // minimum garanti par mois (Growth=6)
  creditsLastResetAt       DateTime? // dernier reset mensuel (1er du mois)
  guaranteeBonusActive     Boolean      @default(false) // true si quota courant double (garantie precedente declenchee)
  // Stripe (Sprint Saint Graal)
  stripeCustomerId         String?      @unique
  stripeSubscriptionId     String?      @unique
  stripeSubscriptionStatus String? // active, past_due, canceled, trialing, incomplete
  stripeCurrentPeriodEnd   DateTime?
  stripePriceId            String? // ID du Stripe Price (pour identifier le plan)
  // Metadata
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  activatedAt              DateTime?
  pausedAt                 DateTime?
  deletedAt                DateTime?

  users       User[]       @relation("ClientOwner")
  triggers    Trigger[]
  leads       Lead[]
  leadCredits LeadCredit[]
  // Sprint 6 (10/05/2026) — opportunities, campaigns, replies, notifications
  // retires (tables droppees post-pivot Data-only)
  rodzSignals RodzSignal[]

  @@index([status])
  @@index([deletedAt])
}

enum ClientStatus {
  PROSPECT // Pas encore signé
  ACTIVE // Signé, en production
  PAUSED // Suspendu (paiement, demande, ...)
  CHURNED // Parti
}

enum ClientPlan {
  GROWTH // 390eur/mo annuel — Sprint Saint Graal (10/05/2026), offre publique unique
  LEADS_DATA // 199eur/mo — DEPRECATED Sprint Saint Graal, garde pour grandfathered (DTL)
  FULL_SERVICE // 890eur/mo — DEPRECATED Sprint Saint Graal
  CUSTOM // Deals enterprise negocies a la main (>1000eur/mo)
}

// =====================================================================
// TRIGGER ENGINE — données métier
// =====================================================================

model Trigger {
  id                           String        @id @default(cuid())
  clientId                     String
  client                       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Source (BODACC, INPI, France Travail, etc — interne, pas exposé client)
  sourceCode                   String // "bodacc.levee", "francetravail.head_of_sales", "inpi.marque"
  sourceUrl                    String?
  capturedAt                   DateTime      @default(now()) // Quand notre moteur l'a vu
  publishedAt                  DateTime? // Quand l'événement public est sorti
  // Entreprise détectée (attribution SIRENE)
  companyName                  String
  companySiret                 String? // SIREN/SIRET
  companyNaf                   String?
  industry                     String?
  region                       String?
  size                         String?
  // Lecture du signal
  type                         TriggerType
  title                        String // "Levée de fonds Série A — 4,5 M€"
  detail                       String? // Description longue
  rawPayload                   Json? // Données brutes de la source
  // Scoring (Claude Opus 4.7)
  score                        Int // 1-10
  scoreReason                  String? // Brief contextuel généré par l'IA
  // Sprint D.1 (07/05/2026) — Brief raisonné v2 : verdict OUI/NON/ENRICH +
  // thesis + triggers cités + risks + opener + sources. Schéma TS dans
  // lib/lead-brief-v2.ts (Zod). Double-write avec scoreReason pendant 30j
  // (Sprint D.5) puis migration progressive.
  briefV2Json                  Json?
  isHot                        Boolean       @default(false) // ≥9
  isCombo                      Boolean       @default(false) // pattern combiné (levée + hire ex)
  // Priority Scoring Engine (chantier #1, 01/05/2026) — voir lib/priority-scoring.ts
  freshnessScore               Int? // 0-100, décroissance exponentielle (demi-vie 14j)
  multiSourceBoost             Int           @default(0) // 0/15/30 selon nb sources distinctes 7j
  priorityScore                Int? // composite final = score × freshness/100 + boost
  // Pipeline
  status                       TriggerStatus @default(NEW)
  ignoredAt                    DateTime?
  ignoredReason                String?
  // Enrichment dedup (évite re-fetch Pappers à chaque cron 6h)
  pappersDirigeantsAttemptedAt DateTime?
  // Declarative pain dedup (audit 30/04). Pose même si rien détecté pour
  // éviter re-scrape Apify $0.002/post × 5 posts/run × 16 runs/jour.
  // TTL 14j : on retente après 2 semaines au cas où la boîte poste enfin
  // une nouvelle douleur.
  declarativePainScannedAt     DateTime?
  // Soft delete
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt
  deletedAt                    DateTime?

  lead Lead?
  // Sprint 6 (10/05/2026) — opportunity retire (Opportunity table droppee)

  @@index([clientId, status, capturedAt(sort: Desc)])
  @@index([clientId, score(sort: Desc)])
  @@index([clientId, isHot])
  @@index([sourceCode])
  @@index([companySiret])
  @@index([deletedAt])
  @@index([clientId, priorityScore(sort: Desc)])
}

enum TriggerType {
  FUNDRAISING // Levée de fonds
  HIRING_KEY // Recrutement clé (Head of X, C-level)
  LEADERSHIP_CHANGE // Changement dirigeant
  TRADEMARK // Dépôt INPI marque
  PATENT // Dépôt brevet
  AD_CAMPAIGN // Campagne pub Meta/LinkedIn
  EXPANSION // Ouverture site / pays
  REGULATORY // Changement réglementaire / status
  BUYING_INTENT // Signal d'achat firmographique (TheirStack searchCompanies)
  CAPITAL_INCREASE // Augmentation de capital BODACC (signal levée pré-officiel)
  JOB_MOVE // Dirigeant a changé de poste <6m (Dropcontact job_move)
  OTHER
}

enum TriggerStatus {
  NEW // À traiter
  CONTACTED // Email envoyé
  REPLIED // Réponse reçue
  BOOKED // RDV pris
  WON // Deal signé
  LOST // Perdu
  IGNORED // Pas pertinent
}

// =====================================================================
// LEAD — contact identifié sur l'entreprise
// =====================================================================

model Lead {
  id                        String      @id @default(cuid())
  clientId                  String
  client                    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  triggerId                 String?     @unique
  trigger                   Trigger?    @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  // Personne
  firstName                 String?
  lastName                  String?
  fullName                  String?
  jobTitle                  String?
  linkedinUrl               String?
  // Contact
  email                     String?
  emailStatus               EmailStatus @default(UNVERIFIED)
  phone                     String?
  // Entreprise (denormalisé pour requêtes rapides)
  companyName               String
  companySiret              String?
  // Pipeline
  status                    LeadStatus  @default(NEW)
  enrichedAt                DateTime? // Quand on a enrichi via Pappers/Dropcontact
  // Brief commercial Opus (généré on-demand, cache 7j)
  briefJson                 Json?
  briefGeneratedAt          DateTime?
  // Kaspr enrichment (LinkedIn → email pro + tel + titre, cache 7j)
  kasprEnrichedAt           DateTime?
  kasprAttemptedAt          DateTime? // Pose même si rien trouvé (évite retentatives <30j)
  kasprWorkEmail            String?
  kasprPersonalEmail        String?
  kasprPhone                String?
  kasprTitle                String?
  kasprCreditsUsed          Int?        @default(0)
  kasprResponseJson         Json?
  // Dropcontact dedup — évite ré-essai des "no email found" à chaque cron
  dropcontactAttemptedAt    DateTime?
  // Rodz dedup — évite ré-essai des "no LinkedIn match" à chaque cron
  rodzAttemptedAt           DateTime?
  // HarvestAPI search-by-company dedup (audit 29/04, Levier 4 anti-pollution).
  // Quand le signal n'apporte pas la personne (Apify Indeed, tech-hiring,
  // TheirStack sans hiring_team), on cherche le décideur tech via
  // harvestapi/linkedin-profile-search filtré par company + titre. Pose
  // même si rien trouvé pour éviter retentatives <30j.
  harvestapiAttemptedAt     DateTime?
  // FullEnrich waterfall (audit 29/04 soir, fallback Kaspr).
  // Pour les leads où Kaspr ne trouve pas email/phone (CTO startups, profils
  // moins indexés Kaspr DB), on tape FullEnrich qui cascade sur 20+ providers
  // (Hunter, Apollo, Anymail Finder, Findymail, Datagma, Lusha, Kaspr...).
  // Crédits déduits seulement si succès (1 cr/email, 10 cr/phone). Pose
  // même si rien trouvé pour éviter retentatives <30j.
  fullenrichAttemptedAt     DateTime?
  emailFullenrich           String?
  phoneFullenrich           String?
  // Tier du décideur trouvé : 1=parfait (CTO/Head of QA pour signal qa-hire),
  // 2=bon (Founder/DSI/Eng Manager), 3=acceptable (CEO/Director), 4=fallback.
  // Sert au filtre dashboard "ne montrer que tier ≤ 2".
  personaTier               Int?
  // Source d'attribution de la persona pour debug/analytics :
  //   "rodz-payload" | "theirstack-hiring-team" | "apify-poster"
  //   | "harvestapi-search" | "pappers-rcs" | "pappers-holding-fallback"
  personaSource             String?
  // LinkedIn finder cascade (étage 3-bis, 30/04). Quand persona connue
  // (firstName+lastName+companyName) mais linkedinUrl manquant, on tape
  // une cascade : Rodz enrichContact → HarvestAPI Profile Search
  // → Google CSE site:linkedin.com/in/. TTL 30j sur le flag pour éviter
  // les retentatives consécutives sur les leads vraiment introuvables.
  linkedinFinderAttemptedAt DateTime?
  // Source de résolution du LinkedIn pour debug/analytics :
  //   "rodz-payload" | "theirstack-hiring-team" | "apify-poster"
  //   | "harvestapi-search-company" | "rodz-enrich-contact"
  //   | "harvestapi-profile-search" | "google-cse" | "dropcontact"
  linkedinSource            String?
  // Multi-source emails (audit qualité Q3, 29/04). On stocke chaque source
  // séparément + un `emailConfidence` calculé pour identifier les emails
  // validés par 2+ sources concordantes (~95% deliverability).
  emailRodz                 String?
  emailDropcontact          String?
  emailConfidence           Int         @default(0) // 0-100 (cf. recompute-email-confidence.ts)
  emailSourceCount          Int         @default(0) // 0-3 sources renseignées
  // Bounce tracking (Q8 audit qualité, 29/04). Si Resend remonte un bounce,
  // on stocke l'email rejeté pour que le waterfall ne re-essaie pas la même
  // adresse au prochain cron + on reset les flags pour relancer Rodz/Dropcontact.
  bouncedAt                 DateTime?
  bouncedFromEmail          String?
  // RGPD opt-out (audit 30/04). Posé automatiquement quand l'IMAP poller
  // détecte une réponse contenant "stop" / "unsubscribe" / "désabonn" /
  // "ne plus me contacter" / "remove me". Filtre les leads de bulk-send-email
  // et du listing dashboard. Posable aussi manuellement par le commercial.
  doNotContact              Boolean     @default(false)
  doNotContactReason        String? // "auto_imap_stop" | "auto_imap_unsub" | "manual_<userId>" | "bounce_repeat"
  doNotContactAt            DateTime?
  // Email history (audit 30/04 soir) — archive les emails écrasés par
  // de nouvelles sources. Format : Json array d'objets
  // { email, source, replacedAt }. Permet audit/rollback en cas de mauvaise
  // décision de waterfall. Limit 5 entrées (FIFO) pour éviter inflation.
  emailHistory              Json?
  // Score qualité données (Q7 audit qualité, 29/04). 0-100 calculé à partir
  // des sources, concordance email, présence mobile FR, signal hot. Permet
  // au commercial de prioriser les pépites dans le dashboard.
  dataQuality               Int         @default(0)
  // Pappers — données financières + signaux pour scoring richesse
  companyRevenue            Int? // CA dernier exercice (€)
  companyResultNet          Int? // Résultat net dernier exercice (€)
  companyHasInsolvency      Boolean     @default(false) // procédure collective en cours
  companyEtabsCount         Int? // Nombre d'établissements (multi-sites = expansion)
  companyRecentDepots       Json? // Dépôts d'actes RCS <90j (nominations, modif. capital)
  // Job moves Dropcontact (signal d'achat — équivalent gratuit Rodz job-changes)
  jobMoveDetected           Boolean     @default(false)
  previousCompany           String?
  previousJob               String?
  // Cache des contenus on-demand (pitch / linkedin DM / call brief) — économie tokens Opus
  pitchJson                 Json?
  pitchGeneratedAt          DateTime?
  linkedinDmJson            Json?
  linkedinDmGeneratedAt     DateTime?
  callBriefJson             Json?
  callBriefGeneratedAt      DateTime?
  // Chantier #3 — Copy Engine unifié (01/05/2026)
  // warmMail = mail post-LinkedIn (référence à un échange préalable, ton plus direct)
  warmMailJson              Json?
  warmMailGeneratedAt       DateTime?
  // Timestamp de génération unifié si /api/leads/[id]/copy a généré les 4 d'un coup
  copyGeneratedAt           DateTime?
  // Chantier #2a — Profil LinkedIn complet (HarvestAPI Profile Full, 01/05/2026)
  // Données extraites : experiences, headline, summary, durée poste actuel.
  // Consommé par chantier #2b (persona fit scoring dynamique).
  linkedinProfileJson       Json?
  linkedinProfileEnrichedAt DateTime?
  // Chantier #2b — Persona Fit Scoring (01/05/2026)
  // Score composite 0-100 = base(tier) + tenureBoost + backgroundFit + sizeFit
  fitScore                  Int?
  fitScoreBreakdown         Json?
  fitScoreComputedAt        DateTime?
  // Audit
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  deletedAt                 DateTime?

  // Sprint 6 (10/05/2026) — opportunities, replies, emailActivity, emailEvents
  // retires (tables droppees post-pivot Data-only)
  activities LeadActivity[]
  // C14 (04/05) — UNIQUE INDEX partiel ajouté hors-Prisma car PARTIAL unique
  // pas supporté par @@unique. Empêche les doublons SIRET sur les leads
  // ACTIFS (deletedAt IS NULL). Permet les Lead.deletedAt NOT NULL en doublon
  // pour préserver l'historique d'archivages successifs sur la même boîte.
  // Migration : prisma/migrations/manual_unique_lead_active_siret.sql
  // SQL : CREATE UNIQUE INDEX "Lead_clientId_companySiret_active_unique"
  //         ON "Lead" ("clientId", "companySiret")
  //         WHERE "deletedAt" IS NULL AND "companySiret" IS NOT NULL;

  @@index([clientId, status, createdAt(sort: Desc)])
  @@index([email])
  @@index([companySiret])
  @@index([deletedAt])
  @@index([clientId, fitScore(sort: Desc)])
}

enum EmailStatus {
  UNVERIFIED
  VALID
  RISKY
  INVALID
  BOUNCED
}

enum LeadStatus {
  NEW
  ENRICHED
  CONTACTABLE
  CONTACTED
  NOT_INTERESTED
  ARCHIVED
}

// =====================================================================
// Sprint 6 (10/05/2026) — 6 models supprimes (post-pivot Data-only) :
//   Opportunity, Campaign, Reply, Notification, EmailActivity, EmailEvent
// Voir backups/schema-pre-sprint6-cleanup.prisma pour restore.
// =====================================================================

// =====================================================================
// AUDIT LOG — trace des actions critiques (auth, ICP edit, delivery, etc.)
// Re-ajoute Sprint 6 (oubli initial dans le schema, table existait via
// migration manuelle SQL avant — on regenere maintenant via Prisma).
// =====================================================================

// =====================================================================
// LEAD CREDIT — transactions de credits (Sprint Saint Graal 10/05/2026)
//
// Chaque debit/credit est trace ici pour audit + calcul rollover + expiry.
// Le solde courant est aussi cache dans Client.creditsBalance pour reads
// rapides (computed depuis l'historique sinon).
//
// Reasons :
//   - "credit_monthly"           : reset mensuel (1er du mois) +60 (ou +120 si guarantee bonus)
//   - "credit_rollover"          : crédits non utilises rolles (expirent 3 mois)
//   - "credit_overage_purchased" : achat overage Stripe metered (8eur/lead)
//   - "credit_guarantee_double"  : bonus garantie Pepite declenchee (quota double mois suivant)
//   - "debit_qualif"             : 1 lead qualif (score >= 6)
//   - "debit_pepite"             : 1 Pepite (score >= 8) — debit credit + increment pepitesThisMonth
//   - "expiry_rollover"          : credits rolles expirent apres 3 mois
// =====================================================================

model LeadCredit {
  id           String    @id @default(cuid())
  clientId     String
  amount       Int // positif = credit ajoute, negatif = debit
  reason       String // voir liste ci-dessus
  triggerId    String? // ref au trigger qui a declenche (debits)
  leadId       String?
  score        Int? // score du trigger pour audit
  isPepite     Boolean   @default(false)
  expiresAt    DateTime? // pour les credits rolles (expiry 3 mois)
  balanceAfter Int // solde apres cette tx (audit/debug)
  metadata     Json? // contexte additionnel
  createdAt    DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([reason, createdAt(sort: Desc)])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  clientId   String?
  action     String // "client.created", "trigger.scored", "user.login", etc.
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

// =====================================================================
// LEAD ACTIVITY — table unifiée multi-canal (email/LinkedIn/appel/RDV/note)
// Permet timeline temps réel + compteurs par lead + stats agrégées par
// commercial. Auto (bot/webhook) + manuel (commercial coche/log).
// =====================================================================

model LeadActivity {
  id              String            @id @default(cuid())
  leadId          String
  lead            Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId        String // denorm pour stats par client
  type            ActivityType
  source          ActivitySource
  direction       ActivityDirection
  occurredAt      DateTime          @default(now())
  userId          String? // commercial qui a fait l'action (null si bot/webhook)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Liens facultatifs vers entités existantes (compat ascendante)
  emailActivityId String? // ref EmailActivity si type=EMAIL_*
  emailEventId    String? // ref EmailEvent si OPEN/CLICK/BOUNCE
  opportunityId   String? // ref Opportunity si MEETING_*
  // Données libres (subject, body excerpt, durée appel, message LinkedIn, note...)
  payload         Json?
  createdAt       DateTime          @default(now())

  @@index([leadId, occurredAt(sort: Desc)])
  @@index([clientId, type, occurredAt(sort: Desc)])
  @@index([userId, occurredAt(sort: Desc)])
}

enum ActivityType {
  EMAIL_SENT
  EMAIL_REPLY
  EMAIL_OPEN
  EMAIL_CLICK
  EMAIL_BOUNCE
  LINKEDIN_DM_SENT
  LINKEDIN_DM_REPLY
  LINKEDIN_VIEW_PROFILE
  LINKEDIN_CONNECT
  CALL_OUTBOUND
  CALL_INBOUND
  VOICEMAIL_LEFT
  MEETING_BOOKED
  MEETING_HELD
  MEETING_NO_SHOW
  NOTE
  STATUS_CHANGE
  // Sprint 7 (05/05/2026) — Outcomes loop Data-only.
  // Track les interactions dashboard du commercial (copy email/phone,
  // click LinkedIn, export CSV, view profil). Payload distingue le kind :
  //   { kind: "view" | "copy_email" | "copy_phone" | "copy_linkedin"
  //          | "copy_brief" | "click_linkedin" | "export_csv" | "archive_manual" }
  DASHBOARD_INTERACTION
}

enum ActivitySource {
  AUTO // bot interne (qualify, brief, pipelines)
  WEBHOOK // Resend, Cal.com, IMAP poller
  MANUAL // commercial coche / clique
  GMAIL_API // futur — auto-detect Gmail Sent
}

enum ActivityDirection {
  OUTBOUND
  INBOUND
}

// =====================================================================
// RODZ SIGNAL — tracking des monitors Rodz créés par client
// =====================================================================

model RodzSignal {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Référence Rodz
  rodzSignalId   String    @unique
  signalType     String // "fundraising", "job-changes", "mergers-acquisitions", ...
  name           String
  webhookUrl     String
  // Config envoyée à Rodz (filtres ICP, keywords, ...)
  config         Json
  dailyLeadLimit Int?
  // État
  status         String    @default("draft") // "draft", "active", "paused"
  active         Boolean   @default(false)
  // Métriques
  leadsReceived  Int       @default(0)
  creditsUsed    Decimal   @default(0) @db.Decimal(10, 2)
  lastLeadAt     DateTime?
  // Audit
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([clientId, active])
  @@index([signalType])
  @@index([deletedAt])
}
